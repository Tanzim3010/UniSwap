{
  "info": {
    "_postman_id": "80ea351a-6c8c-46c3-8db1-9bd976b0bf4e",
    "name": "UniSwap - Listings",
    "description": "Listing API tests. Set categoryId to an active category UUID before creating a listing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login as listing owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create listing",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Listing {{$timestamp}}\",\n  \"description\": \"Created while testing the listings API\",\n  \"price\": 25.5,\n  \"condition\": \"GOOD\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"imageUrls\": [\"https://example.com/item.jpg\"],\n  \"location\": \"Campus\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/listings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listing is created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('listingId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Browse active listings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/listings?page=1&limit=20&sort=price_asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listings are returned with pagination', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().items).to.be.an('array');",
              "  pm.expect(pm.response.json()).to.have.property('total');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Browse listings by filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/listings?page=1&limit=10&search=Postman&categoryId={{categoryId}}&minPrice=1&maxPrice=100&sort=price_asc"
      }
    },
    {
      "name": "Get listing by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/listings/{{listingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listing is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('listingId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List my listings",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/listings/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Owner listings are returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().items).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update listing",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 20,\n  \"status\": \"RESERVED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/listings/{{listingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listing is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('RESERVED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete listing",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/listings/{{listingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listing is soft-deleted', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "listingId",
      "value": ""
    }
  ]
}
