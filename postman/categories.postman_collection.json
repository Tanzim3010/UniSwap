{
  "info": {
    "_postman_id": "9bb0c46a-3ca4-4b91-a06d-02f59c08db91",
    "name": "UniSwap - Categories",
    "description": "Category API tests. Create, update, and deactivate requests require an ADMIN or SUPER_ADMIN token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List active categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Categories are returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Category {{$timestamp}}\",\n  \"description\": \"Created while testing the categories API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category is created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "  const category = pm.response.json();",
              "  pm.collectionVariables.set('categoryId', category.id);",
              "  pm.collectionVariables.set('categorySlug', category.slug);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get category by slug",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/{{categorySlug}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().slug).to.eql(pm.collectionVariables.get('categorySlug'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated by the Postman category collection\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().description).to.eql('Updated by the Postman category collection');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category is deactivated', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "categorySlug",
      "value": ""
    }
  ]
}
